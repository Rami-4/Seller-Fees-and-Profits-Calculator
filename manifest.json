{
  "manifest_version": 3,
  "name": "Seller Fees & Profits Calculator",
  "version": "1.3",
  "description": "Instantly calculate net profit, fees, break-even price, and 1-click import listings.",
  "action": {
    "default_title": "Seller Fees & Profits Calculator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}